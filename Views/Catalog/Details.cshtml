@model Marketplace.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<div class="breadcrumbs">
    <a href="/">Главная</a> &gt;
    <a href="/Catalog">Каталог</a> &gt;
    <a href="/Catalog?category=@Model.SubCategory">@Model.SubCategory</a> &gt;
    <span>@Model.Name</span>
</div>

<div class="product-details">
    <div class="product-details-image">
        <div class="product-details-image">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name" style="max-width: 100%; max-height: 400px; object-fit: contain;" />
            }
            else
            {
                <div class="image-placeholder">
                    <span style="font-size: 5rem;">👕</span>
                    <p>@Model.Name</p>
                </div>
            }
        </div>
    </div>

    <div class="product-details-info">
        <h1>@Model.Name</h1>

        <div class="product-description">
            <h3>Описание:</h3>
            <p>@Model.Description</p>
        </div>

        <div class="product-specs">
            <h3>Детали:</h3>
            <ul>
                @if (!string.IsNullOrEmpty(Model.Composition))
                {
                    <li><strong>Состав:</strong> @Model.Composition</li>
                }
                @if (!string.IsNullOrEmpty(Model.CareInstructions))
                {
                    <li><strong>Уход:</strong> @Model.CareInstructions</li>
                }
                @if (!string.IsNullOrEmpty(Model.AvailableSizes))
                {
                    <li><strong>Доступные размеры:</strong> @Model.AvailableSizes</li>
                }
            </ul>
        </div>

        <div class="product-price-block">
            <h2>Цена:</h2>
            <p class="product-details-price">@Model.Price.ToString("N0") руб.</p>
        </div>
        @if (Model.Stock > 0)
        {
            <p style="color: #27ae60; font-weight: 600;">В наличии: @Model.Stock шт.</p>
        }
        else
        {
            <p style="color: #e74c3c; font-weight: 600;">Товара нет в наличии</p>
        }
        <div class="product-actions">
            @if (Model.Stock > 0)
            {
                <a href="/Cart/Add/@Model.Id" class="btn btn-success btn-large">Купить сейчас</a>
                <a href="/Cart/Add/@Model.Id" class="btn btn-primary btn-large">Добавить в корзину</a>
            }
            else
            {
                <button class="btn btn-secondary btn-large" disabled>Нет в наличии</button>
            }
        </div>
    </div>
</div>