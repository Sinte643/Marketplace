@model IEnumerable<Marketplace.Models.Product>

@{
    ViewData["Title"] = "Каталог";
    var currentCategory = ViewBag.CurrentCategory as string;
}

<h1>Каталог товаров</h1>

<div class="category-filter">
    <a href="/Catalog" class="filter-btn @(string.IsNullOrEmpty(currentCategory) ? "active" : "")">Все товары</a>
    <a href="/Catalog?category=Мужская одежда" class="filter-btn @(currentCategory == "Мужская одежда" ? "active" : "")">Мужская одежда</a>
    <a href="/Catalog?category=Верхняя одежда" class="filter-btn @(currentCategory == "Верхняя одежда" ? "active" : "")">Верхняя одежда</a>
    <a href="/Catalog?category=Мужская обувь" class="filter-btn @(currentCategory == "Мужская обувь" ? "active" : "")">Обувь</a>
    <a href="/Catalog?category=Аксессуары" class="filter-btn @(currentCategory == "Аксессуары" ? "active" : "")">Аксессуары</a>
</div>

<div class="catalog-grid">
    @foreach (var item in Model)
    {
        <div class="product-card">
            <div class="product-image">
                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" alt="@item.Name" style="max-width: 100%; max-height: 200px; object-fit: contain;" />
                }
                else
                {
                    <span class="product-image-icon">👕</span>
                }
            </div>
            <h3>@item.Name</h3>
            <p>@item.Price.ToString("N0") ₽</p>
            @if (item.Stock > 0)
            {
                <p style="font-size: 0.9rem; color: #27ae60; margin: 0 16px 8px;">В наличии: @item.Stock шт.</p>
            }
            else
            {
                <p style="font-size: 0.9rem; color: #e74c3c; margin: 0 16px 8px;">Нет в наличии</p>
            }
            <a href="/Catalog/Details/@item.Id" class="btn btn-primary">Подробнее</a>
        </div>
    }
</div>