@model IEnumerable<Marketplace.Models.User>

@{
    ViewData["Title"] = "Пользователи";
}

<h1>Пользователи</h1>
<div style="margin-top: 20px;">
    <a href="/Admin" class="btn btn-secondary">← Назад в админ-панель</a>
</div>
<div class="orders-table-container">
    <table class="orders-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Имя</th>
                <th>Фамилия</th>
                <th>Email</th>
                <th>Телефон</th>
                <th>Роль</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.FirstName</td>
                    <td>@user.LastName</td>
                    <td>@user.Email</td>
                    <td>@user.Phone</td>
                    <td>@user.Role</td>
                </tr>
            }
        </tbody>
    </table>
</div>