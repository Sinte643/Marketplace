@model Marketplace.Models.Product

@{
    ViewData["Title"] = Model.Id == 0 ? "Добавить товар" : "Редактировать товар";
}

<h1>@ViewData["Title"]</h1>
@if (!ViewData.ModelState.IsValid)
{
    <div style="color: #e74c3c; font-weight: 600; margin-bottom: 15px; padding: 10px; background: #fde8ec; border-radius: 8px; border: 2px solid #e74c3c;">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p>⚠️ @error.ErrorMessage</p>
        }
    </div>
}
<form method="post" action="/Admin/ProductEdit" asp-antiforgery="true" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ImageUrl" />
    <div class="form-group"><label>Название</label><input asp-for="Name" class="form-control" required /></div>
    <div class="form-group">
        <label>Категория</label>
        <select asp-for="Category" id="categorySelect" class="form-control" onchange="updateSubcategories()">
            <option>Одежда</option>
            <option>Обувь</option>
            <option>Аксессуары</option>
        </select>
    </div>
    <div class="form-group">
        <label>Подкатегория</label>
        <select asp-for="SubCategory" id="subcategorySelect" class="form-control">
            <option value="">Выберите подкатегорию</option>
        </select>
    </div>
    <div class="form-group"><label>Цена</label><input asp-for="Price" class="form-control" type="number" step="0.01" min="0" required /></div>
    <div class="form-group"><label>Описание</label><textarea asp-for="Description" class="form-control" rows="4"></textarea></div>
    <div class="form-group"><label>Состав</label><input asp-for="Composition" class="form-control" /></div>
    <div class="form-group"><label>Уход</label><input asp-for="CareInstructions" class="form-control" /></div>
    <div class="form-group"><label>Размеры</label><input asp-for="AvailableSizes" class="form-control" placeholder="S,M,L,XL" /></div>
    <div class="form-group"><label>Количество на складе</label><input asp-for="Stock" class="form-control" type="number" min="0" /></div>
    <div class="form-group">
        <label>Изображение товара</label>
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div style="margin-bottom: 10px;">
                <img src="@Model.ImageUrl" style="max-width: 200px; border-radius: 8px;" />
            </div>
        }
        <input type="file" name="imageFile" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp" />
    </div>
    <button type="submit" class="btn btn-success">Сохранить</button>
    <a href="/Admin/Products" class="btn btn-secondary">← Назад к товарам</a>
</form>

<script>
    var subcategories = {
        'Одежда': ['Мужская одежда', 'Верхняя одежда'],
        'Обувь': ['Мужская обувь'],
        'Аксессуары': ['Ремни', 'Шарфы', 'Перчатки', 'Головные уборы']
    };

    function updateSubcategories() {
        var category = document.getElementById('categorySelect').value;
        var subSelect = document.getElementById('subcategorySelect');
        subSelect.innerHTML = '<option value="">Выберите подкатегорию</option>';
        if (subcategories[category]) {
            subcategories[category].forEach(function(sub) {
                var opt = document.createElement('option');
                opt.value = sub;
                opt.text = sub;
                subSelect.add(opt);
            });
        }
    }

    window.onload = function() {
        updateSubcategories();
        var currentSub = '@Model.SubCategory';
        if (currentSub) {
            document.getElementById('subcategorySelect').value = currentSub;
        }
    };
</script>