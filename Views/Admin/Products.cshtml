@model IEnumerable<Marketplace.Models.Product>

@{
    ViewData["Title"] = "Управление товарами";
}

<h1>Управление товарами</h1>
<a href="/Admin/ProductEdit" class="btn btn-success" style="margin-bottom: 20px;">+ Добавить товар</a>

<div class="orders-table-container">
    <table class="orders-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Название</th>
                <th>Категория</th>
                <th>Цена</th>
                <th>Склад</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Category</td>
                    <td>@item.Price.ToString("N0") ₽</td>
                    <td>@item.Stock шт.</td>
                    <td>
                        <a href="/Admin/ProductEdit/@item.Id" class="btn btn-primary btn-sm">✏️</a>
                        <button class="btn btn-danger btn-sm" onclick="showDeleteModal(@item.Id, '@item.Name')">🗑️</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div style="margin-top: 20px;">
    <a href="/Admin" class="btn btn-secondary">← Назад в админ-панель</a>
</div>

<div id="deleteModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 1000; justify-content: center; align-items: center;">
    <div style="background: white; border-radius: 12px; padding: 30px; max-width: 450px; text-align: center; border: 3px solid #2c3e50;">
        <span style="font-size: 3rem;">⚠️</span>
        <h3 style="color: #1a1a2e; margin: 15px 0;">Удаление товара</h3>
        <p style="margin-bottom: 10px;">Вы действительно хотите удалить товар?</p>
        <p id="deleteProductName" style="font-weight: 700; color: #e94560; font-size: 1.2rem; margin-bottom: 20px;"></p>
        <div style="display: flex; gap: 10px; justify-content: center;">
            <button onclick="closeDeleteModal()" class="btn btn-secondary">← Отмена</button>
            <a id="deleteConfirmLink" href="#" class="btn btn-danger">🗑️ Удалить</a>
        </div>
    </div>
</div>

<script>
    function showDeleteModal(id, name) {
        document.getElementById('deleteModal').style.display = 'flex';
        document.getElementById('deleteProductName').innerText = name;
        document.getElementById('deleteConfirmLink').href = '/Admin/ProductDelete/' + id;
    }
    function closeDeleteModal() {
        document.getElementById('deleteModal').style.display = 'none';
    }
    window.onclick = function(event) {
        if (event.target == document.getElementById('deleteModal')) {
            closeDeleteModal();
        }
    }
</script>