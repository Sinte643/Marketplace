@model IEnumerable<Marketplace.Models.Product>

@{
    ViewData["Title"] = "Магазин одежды";
}

<div class="home-container">
    <aside class="home-sidebar">
        <h2>Категории</h2>
        <nav>
            <ul class="sidebar-nav">
                <li><a href="/Catalog?category=Мужская одежда">Мужская одежда</a></li>
                <li><a href="/Catalog?category=Верхняя одежда">Верхняя одежда</a></li>
                <li><a href="/Catalog?category=Мужская обувь">Обувь</a></li>
                <li><a href="/Catalog?category=Аксессуары">Аксессуары</a></li>
                <li><a href="/Catalog">Все товары</a></li>
            </ul>
        </nav>
    </aside>

    <main class="home-main">
        <div class="welcome-section">
            <h1>Добро пожаловать в магазин одежды!</h1>
            <p>Лучшие товары по доступным ценам</p>
            <a href="/Catalog" class="btn btn-primary btn-large">Перейти в каталог</a>
        </div>

        <h2>Популярные товары</h2>
        <div class="catalog-grid">
            @foreach (var item in Model)
            {
                <div class="product-card">
                    <div class="product-image">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Name" style="max-width: 100%; max-height: 200px; object-fit: contain;" />
                        }
                        else
                        {
                            <span class="product-image-icon">👕</span>
                        }
                    </div>
                    <h3>@item.Name</h3>
                    <p>@item.Price.ToString("N0") ₽</p>
                    @if (item.Stock > 0)
                    {
                        <p style="font-size: 0.9rem; color: #27ae60; margin: 0 16px 8px;">В наличии: @item.Stock шт.</p>
                    }
                    else
                    {
                        <p style="font-size: 0.9rem; color: #e74c3c; margin: 0 16px 8px;">Нет в наличии</p>
                    }
                    <a href="/Catalog/Details/@item.Id" class="btn btn-primary">Подробнее</a>
                </div>
            }
        </div>
    </main>
</div>

<div class="banners-row">
    <a href="/Catalog?category=Мужская одежда" class="banner-card">
        <span class="banner-icon">🚚</span>
        <h3>Бесплатная доставка</h3>
        <p>При заказе от 3000 ₽</p>
    </a>
    <a href="/Catalog?category=Верхняя одежда" class="banner-card">
        <span class="banner-icon">🔄</span>
        <h3>Лёгкий возврат</h3>
        <p>30 дней на обмен</p>
    </a>
    <a href="/Catalog?category=Аксессуары" class="banner-card">
        <span class="banner-icon">⭐</span>
        <h3>Оригинальное качество</h3>
        <p>Гарантия на всё</p>
    </a>
</div>